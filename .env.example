# Copy this file to .env.local and fill in the two keys.
# Never commit .env.local.

# https://elevenlabs.io -> Developers -> API keys
ELEVENLABS_API_KEY=

# https://platform.claude.com -> API keys
ANTHROPIC_API_KEY=

# Optional. Leave blank to use the defaults in lib/server/env.ts.
ELEVENLABS_VOICE_ID=
ELEVENLABS_CHARACTER_VOICE_ID=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_STT_MODEL=
ANTHROPIC_MODEL=
